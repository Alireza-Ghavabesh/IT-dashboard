datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Letter {
  id                 String   @id @default(cuid())
  letterId           String?
  actionType         String   @default("ویرایش")
  subject            String?
  orgUnit            String?
  sender             String?
  receiver           String?
  dateStr            String?
  monthName          String?
  creatorName        String?
  creatorRole        String?
  creatorRaw         String?
  urgency            String?
  status             String?
  registrationNumber String?
  rawJson            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([orgUnit])
  @@index([actionType])
  @@index([dateStr])
}

model EraProcess {
  id            String   @id @default(cuid())
  processName   String
  orgUnit       String
  executionDate String
  operationType String   @default("اصلاح")
  entityType    String?  @default("فرآیند")
  description   String
  rawJson       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        ProcessImage[]

  @@index([orgUnit])
  @@index([operationType])
  @@index([entityType])
}

model ProcessImage {
  id          String      @id @default(cuid())
  processId   String
  processName String?
  imageData   String      // Base64 image data stored directly in SQLite
  mimeType    String      @default("image/png")
  title       String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  process     EraProcess? @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([processName])
}

model CauseRule {
  id          String   @id @default(cuid())
  keyword     String
  cause       String   // e.g. "بانکی"
  targetUnit  String?  // e.g. "حسابداری مالی" or null/"all"
  matchType   String   @default("contains") // "contains", "exact", "startsWith"
  targetField String?  @default("all") // Dynamic field/column from Excel e.g. "یادداشت", "موضوع", "all", etc.
  isActive    Boolean  @default(true)
  color       String?  @default("#2563EB")
  description String?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cause])
  @@index([targetUnit])
}

model ExclusionRule {
  id         String   @id @default(cuid())
  keyword    String
  targetUnit String?  // Specific unit or null for all
  matchType  String   @default("contains") // "contains", "exact", "startsWith"
  field      String   @default("subject") // "subject", "creator", "any"
  isActive   Boolean  @default(true)
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([keyword])
  @@index([targetUnit])
}

model AppSetting {
  key       String   @id
  value     String   // Stored as JSON string
  updatedAt DateTime @updatedAt
}

model DanaTicket {
  id                   String    @id @default(cuid())
  ticketId             String?   @unique // Dana Ticket UUID e.g. "c8749c73-44ff-46f5-b982-f7303649ec1c"
  ticketNumber         Int       @unique // e.g. 3041
  title                String
  status               String    @default("نامشخص") // e.g. "انجام شده", "بسته", ...
  statusId             String?
  applicantName        String?   @default("ناشناس")
  applicantId          String?
  itStaffName          String?   @default("تخصیص‌نیافته")
  itStaffId            String?
  createDateIso        String?   // e.g. "2026-10-12T12:17:00"
  createDateFa         String?   // e.g. "1405/07/21 12:17"
  satisfactionRateName String?
  satisfactionRate     Int?
  priorityName         String?
  priorityId           String?
  isRemoved            Boolean   @default(false)
  rawJson              String?   // Full original Dana payload
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([itStaffName])
  @@index([applicantName])
  @@index([createDateIso])
}

